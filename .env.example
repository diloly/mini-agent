# mini-agent 环境变量示例（复制为 .env 并填入真实值；.env 已被 gitignore）
#
# MAIN_VITE_ 前缀由 electron-vite 约定注入主进程（import.meta.env.MAIN_VITE_*）。
# 只允许 publishable key：它可公开、受数据库 RLS 约束；
# 绝不要在此放置任何高权限密钥。

MAIN_VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# 形如 sb_publishable_xxxxxxxx 的可公开密钥
MAIN_VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
